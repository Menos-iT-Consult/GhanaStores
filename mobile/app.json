{
  "expo": {
    "name": "DiDwa Seller",
    "slug": "didwaghana",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "didwa",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8FAFC",
    "primaryColor": "#0066FF",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.didwa.seller",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.didwa.seller",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1120"
      },
      "icon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#0066FF"
        }
      ],
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "78f88e44-2b31-4981-a689-7749951bf439"
      }
    },
    "owner": "didwa",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC"
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#0066FF"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
