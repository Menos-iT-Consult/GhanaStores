{
  "expo": {
    "name": "DiDwa Seller",
    "slug": "didwa-seller",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "didwa",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8FAFC",
    "primaryColor": "#0066FF",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.didwa.buy",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.didwa.buy",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1120"
      },
      "icon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#0066FF"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "StoreWidget",
              "label": "DiDwa store",
              "description": "Today's revenue, pending orders and low stock at a glance",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "37d39de8-d8d0-4f18-b518-39d4910adc29"
      }
    },
    "owner": "menositconsults-team",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#F8FAFC"
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#0066FF"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
