{
  "expo": {
    "name": "DiDwa Seller",
    "slug": "didwa-seller",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "didwa",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8FAFC",
    "primaryColor": "#0066FF",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.didwa.seller"
    },
    "android": {
      "package": "com.didwa.seller",
      "adaptiveIcon": {
        "backgroundColor": "#0066FF"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#0066FF"
        }
      ],
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b158b5a8-c03a-42c1-bb91-557900e41dc9"
      }
    },
    "owner": "didwaghana"
  }
}
