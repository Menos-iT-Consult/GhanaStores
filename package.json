{
  "name": "didwa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DiDwa - Multi-tenant e-commerce platform & seller PWA for the Ghanaian market (GHS)",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "nodemon server.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:routing": "node scripts/routeTest.js",
    "test:admin": "node scripts/adminApiTest.js",
    "test:admin-host": "node scripts/adminHostTest.js",
    "test:uploads": "node scripts/uploadTest.js",
    "test:domain-pricing": "node scripts/domainPricingTest.js",
    "test:catalog": "node scripts/catalogSeedTest.js",
    "test:domain-dns": "node scripts/domainDnsTest.js",
    "test:domain-provisioning": "node scripts/domainProvisioningTest.js",
    "test:errors": "node scripts/errorHandlingTest.js",
    "test:responsive": "node scripts/responsiveTest.js",
    "test:dashboard-refactor": "node scripts/dashboardRefactorTest.js",
    "test:customizer-render": "node scripts/customizerRenderTest.js",
    "test:payments": "node scripts/paymentTest.js",
    "test:payments-db": "node scripts/paymentDbTest.js",
    "payments:repair-db": "node scripts/paymentDbRepair.js",
    "test:storefront-theme": "node scripts/storefrontThemeTest.js",
    "test:storefront": "node scripts/storefrontRenderTest.js",
    "start": "NODE_ENV=production node server.js",
    "db:init": "node scripts/dbInit.js",
    "db:reset": "node scripts/dbReset.js",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node scripts/dbSeed.js",
    "r2:cors": "node scripts/r2Cors.js",
    "admin:create": "node scripts/createAdmin.js",
    "token": "node scripts/mintToken.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@vercel/postgres": "^0.10.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.469.0",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.1",
    "postcss": "^8.4.49",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  }
}
