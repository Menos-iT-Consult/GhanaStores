# ============================================================
# DIDWA - Environment Configuration
# Copy to .env and fill in real credentials for production.
# Every integrations degrades gracefully to DRY_RUN mode when
# credentials are absent, so local development works out of the box.
# ============================================================

# --- Core ---
PORT=4000
# Vercel sets NODE_ENV=production for builds and runtime. Set it explicitly when
# self-hosting: it enables static serving from dist/ and makes webhook
# verification strict (HUBTEL_WEBHOOK_SECRET then becomes mandatory).
NODE_ENV=production
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Apex domain used for tenant subdomains and by the Host-header resolver.
# In production this is your real domain (didwaghana.com); for local dev
# keep localhost:5173 so *.lvh.me / localhost traffic is never tenanted.
ROOT_DOMAIN=didwaghana.com
# Falls back to ROOT_DOMAIN, then to didwaghana.com, when unset. The apex is
# therefore never classified as a seller storefront.
PLATFORM_DOMAIN=didwaghana.com
# Public origin used to build PDF receipt / verification links.
PLATFORM_URL=https://didwaghana.com
# CNAME target shown to sellers connecting their own domain. On Vercel this
# is the project-specific value from Settings > Domains (e.g.
# 01c53a14e266ef4f.vercel-dns-017.com), not cname.<PLATFORM_DOMAIN>.
# Optional: only needed when sellers can point their own domain at the platform.
# Copy the exact value from Vercel -> Settings -> Domains; it is unique per project.
CNAME_TARGET=01c53a14e266ef4f.vercel-dns-017.com
ENABLE_CRON=false

# --- Client (Vite - must keep the VITE_ prefix to reach the browser) ---
# Platform apex domain used to build store subdomains in the seller PWA.
# Fallback only: the browser adopts the apex reported by the API. Keep it
# in sync with PLATFORM_DOMAIN; accepts a protocol for dev (http://lvh.me:5173).
VITE_PLATFORM_DOMAIN=didwaghana.com
# Extra host suffixes the browser treats as platform traffic, comma separated
# (e.g. vercel.app on Preview deployments). Leave unset in production so only
# the real apex renders the marketing site.
# VITE_PREVIEW_HOSTS=vercel.app
# Platform contact phone (E.164 or spaced; drives the Contact Us page links).
# Falls back to a placeholder when unset.
# VITE_PLATFORM_PHONE=+233 20 123 4567

# --- Neon PostgreSQL ---
# Use the POOLED connection string (host contains `-pooler`): many serverless
# instances share one connection budget. Never use the direct host here.
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/didwa?channel_binding=require&sslmode=require

# --- 2-Way Payments: MTN MoMo API (primary for MTN numbers) ---
# https://momodeveloper.mtn.com/
# MTN numbers (024/025/053/054/055/059) are charged/paid via MTN first;
# Telecel/Vodafone + AT numbers go straight to Hubtel, which is also the
# one-time fallback when the MTN leg fails, errors, times out, or is still
# pending after polling. Leave MTN_* empty to run MTN in dry-run (simulated
# success) - Hubtel still handles non-MTN traffic per its own keys below.
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_COLLECTION_USER_ID=
MTN_MOMO_COLLECTION_API_KEY=
# Optional: separate disbursement API user; defaults to the collection user.
# MTN_MOMO_DISBURSEMENT_USER_ID=
# MTN_MOMO_DISBURSEMENT_API_KEY=
# `sandbox` simulates; `mtn-ghana` moves REAL money. The two settings are a
# pair - MTN rejects the request if they disagree. To go live, change exactly:
#   MTN_MOMO_TARGET_ENVIRONMENT=mtn-ghana
#   MTN_MOMO_BASE_URL=https://momodeveloper.mtn.com
# and use PRODUCTION keys from the MTN portal (sandbox keys fail against the
# live host, and every failure silently looks like a declined payment).
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
# MTN_MOMO_PARTY_ID_TYPE=MSISDN
# MTN_MOMO_CURRENCY=GHS
# Live base URL (leave unset while on sandbox):
# MTN_MOMO_BASE_URL=https://momodeveloper.mtn.com
# There is no callback receiver yet - the platform polls MTN for the result - so
# leave MTN_MOMO_CALLBACK_URL unset until one is added.
# MTN_MOMO_TIMEOUT_MS=8000
# MTN_MOMO_POLL_ATTEMPTS=3
# MTN_MOMO_POLL_INTERVAL_MS=2000
# Hubtel retry when the MTN leg fails. Keep this `false` until HUBTEL_CLIENT_ID /
# _SECRET / _MERCHANT_ACCOUNT are real: with them empty, Hubtel runs in DRY_RUN
# mode and returns `success: true`, so a failed MTN charge would be marked paid
# with no money collected. (`false` fails the payment instead - the safe side.)
PAYMENT_FALLBACK_ENABLED=true

# --- Hubtel (fallback provider + Telecel/AT traffic) ---
# https://developers.hubtel.com/
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT=
HUBTEL_CALLBACK_URL=https://didwaghana.com/api/webhooks/hubtel
# REQUIRED IN PRODUCTION. Without it every Hubtel webhook (payments and domain
# provisioning) is refused, because the caller cannot be verified.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HUBTEL_WEBHOOK_SECRET=
# Per-network channel codes; the defaults are shown. Override only if Hubtel
# issues different codes for your account.
# HUBTEL_CHANNEL_MTN=mtn-gh
# HUBTEL_CHANNEL_VODAFONE=vodafone-gh
# HUBTEL_CHANNEL_AT=airteltigo-gh
# Payout requests at or above this amount require manual admin review (GHS)
RISK_THRESHOLD_GHS=5000

# --- Arkesel SMS ---
# https://arkesel.com/
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=DiDwa
# ARKESEL_BASE_URL=https://sms.arkesel.com/api/v2

# --- Frontend origin (CORS) ---
# The seller PWA is same-origin with the apex in production, so the apex is
# enough. Use `*` only if the PWA is also served from a different host.
CLIENT_URL=https://didwaghana.com

# --- Cloudflare for SaaS (Flow A: Custom Hostnames / BYOD) ---
# https://developers.cloudflare.com/cloudflare-for-saas/
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# The Cloudflare for SaaS FALLBACK ORIGIN: the hostname every merchant points
# BOTH @ and www at with a CNAME (or ALIAS/ANAME). It replaces the old
# CLOUDFLARE_PROXY_IP=104.16.0.1 A record, which Cloudflare rejects with Error
# 1000 ("DNS points to prohibited IP") because that is a proxied edge address
# rather than a real origin. Defaults to fallback.<PLATFORM_DOMAIN>.
DOMAIN_FALLBACK_ORIGIN=fallback.didwaghana.com

# --- Openprovider (Flow B: Domain Registration) ---
# https://support.openprovider.nl/hc/en-us/articles/360014534994
OPENPROVIDER_API_URL=https://api.openprovider.eu/v1
OPENPROVIDER_USERNAME=
OPENPROVIDER_PASSWORD=

# --- Hubtel Checkout (Flow B: Domain Purchase) ---
# https://developer.hubtel.com/docs
HUBTEL_CHECKOUT_BASE_URL=https://api.hubtel.com

# --- Super admin host ---
# The super admin is served on its own subdomain: admin.didwaghana.com. It is
# DERIVED from the apex above (admin.<PLATFORM_DOMAIN>), so it can never drift;
# set ADMIN_DOMAIN only if you genuinely host it elsewhere.
#   /admin on any other host (apex, www, or a seller's storefront) redirects
#   here, so the privileged sign-in is never served in front of customers.

# --- Cloudflare R2 (seller product photos + store logos) ---
# Uploads are presigned: the browser PUTs the bytes straight to R2, so image
# bytes never pass through the app server.
#   R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY  from Cloudflare
#   -> R2 -> Manage R2 API Tokens -> create an Object Read & Write token.
#   R2_BUCKET           the bucket name, e.g. didwa-media
#   R2_PUBLIC_URL       the bucket's PUBLIC custom domain. This must be a
#                       Cloudflare-proxied hostname, because delivery goes
#                       through /cdn-cgi/image/... (Cloudflare Image Resizing).
#                       It does NOT have to be the API endpoint.
#   R2_IMAGE_RESIZE     set to "off" to serve originals instead of resizing
#                       (use while troubleshooting the zone's image resizing).
#   R2_ALLOWED_ORIGINS  comma-separated browser origins allowed to upload, or
#                       "*" (the default). Only the ORIGIN is restricted, never
#                       the write: a PUT still needs a valid presigned URL.
# The bucket MUST carry a CORS policy. The signed PUT is sent by the browser to
# <account>.r2.cloudflarestorage.com, which is a different origin, so the browser
# preflights it first and R2 refuses without a bucket rule ("blocked by CORS
# policy" / net::ERR_FAILED, and nothing reaches the bucket). Apply the policy
# this code expects with:  npm run r2:cors -- --apply   (verify: npm run r2:cors)
# Create the bucket with a lifecycle rule that deletes objects unreferenced for
# 7 days, so a product that is never saved after its upload cannot pile up.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://media.didwaghana.com
# R2_IMAGE_RESIZE=off
# R2_ALLOWED_ORIGINS=*

# --- Domain Pricing ---
# Wholesale-to-retail multiplier (1.25 = 25% margin). Prices rounded to nearest 5 GHS.
DOMAIN_MARGIN=1.25

# ============================================================
# VERCEL DEPLOYMENT
# Set these in Project Settings -> Environment Variables.
# ============================================================

# Protects GET /api/cron/billing (the path vercel.json registers; hit daily).
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# --- Platform administrator bootstrap ---
# These are optional inputs for `npm run admin:create` only. The running
# application does not read them; the created account is stored as a bcrypt
# hash in the platform_admins table. Do not keep a production password here.
ADMIN_EMAIL=admin@didwaghana.com
ADMIN_PASSWORD=use-a-password-of-at-least-10-characters
ADMIN_NAME=Platform Administrator

# Serverless tip: on Vercel keep the pool small; every instance shares Neon.
PGPOOL_MAX=3

# --- Production domain (didwaghana.com: Cloudflare DNS + Vercel hosting) ---
# Seller storefronts are reached at <slug>.didwaghana.com, so the wildcard must
# both resolve in Cloudflare AND be added as a domain on the Vercel project.
#   Apex A    @       -> the IPs on the Vercel domain card (remove any AAAA)
#   CNAME     www     -> <project>.vercel-dns-017.com   (DNS only)
#   CNAME     *       -> <project>.vercel-dns-017.com   (Proxied)
#   TXT       _vercel -> the value Vercel shows when you add the wildcard
# Cloudflare Universal SSL covers *.didwaghana.com (one level) for the browser,
# but the origin leg only succeeds once the wildcard is on the Vercel project;
# until then every storefront subdomain fails with Cloudflare error 525.
# Vercel cannot issue a WILDCARD certificate while DNS lives at Cloudflare:
# wildcards use the DNS-01 challenge, which needs ns1/ns2.vercel-dns.com.
# Cloudflare Registrar domains cannot change nameservers, so keep the proxied
# wildcard and set SSL/TLS to Full (strict), falling back to Full on 525.
# ============================================================
# VERCEL - production variables
# Project Settings -> Environment Variables -> Production. .env is NOT deployed,
# so anything missing here breaks live traffic:
#   PLATFORM_DOMAIN            didwaghana.com
#   ROOT_DOMAIN                didwaghana.com
#   VITE_PLATFORM_DOMAIN       didwaghana.com  (build-time fallback, redeploy after)
#   PLATFORM_URL               https://didwaghana.com
#   CNAME_TARGET               01c53a14e266ef4f.vercel-dns-017.com
#   DOMAIN_FALLBACK_ORIGIN     fallback.didwaghana.com  (seller custom domains)
#   DATABASE_URL               Neon POOLED connection string
#   JWT_SECRET                 long random string
#   CRON_SECRET                long random string (Vercel sends it as a bearer)
#   HUBTEL_WEBHOOK_SECRET      long random string, else webhooks are refused
#   CLIENT_URL                 https://didwaghana.com
#   PGPOOL_MAX                 3
# Preview only: VITE_PREVIEW_HOSTS=vercel.app
# ============================================================
